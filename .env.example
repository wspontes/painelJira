# Copie para .env.local (local) ou configure como Environment Variables no Vercel.

# Site do Jira Cloud (sem https://)
JIRA_SITE=sup-ngx.atlassian.net

# Email da conta Atlântica com acesso à API
JIRA_USER=seu.email@empresa.com

# API Token gerado em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=cole-o-token-aqui

# JQL da fila que será monitorada (fila 23 N1, pode trocar)
JQL=project = SUP AND "Request Type" = "Formulário de Bug (SUP)" AND "Tipo de Suporte" = N1 AND status not in (Fechado, Cancelada, Resolvido, Concluída, Recusada, Failed) ORDER BY priority DESC